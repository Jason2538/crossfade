# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# LASTFM_API_KEY 가 비어 있으면 샘플 데이터로 동작하는 데모 모드로 실행됩니다.

# https://www.last.fm/api/account/create 에서 무료로 발급받습니다.
LASTFM_API_KEY=

# 친구들에게 알려줄 초대 코드입니다. 8자 이상을 권장합니다.
INVITE_CODE=

# 넣으면 Spotify 친구가 Spotify 계정으로 바로 로그인할 수 있습니다. 비워 두면 Last.fm 연결만 씁니다.
# https://developer.spotify.com/dashboard 에서 앱을 만들고 Client ID를 복사하세요. (앱 주인은 Premium 필요)
# 앱의 Redirect URI에는 http://127.0.0.1:3000/api/spotify/callback 을 등록합니다.
# 배포할 때는 SPOTIFY_REDIRECT_URI 를 https 주소로 바꾸세요.
SPOTIFY_CLIENT_ID=
# SPOTIFY_REDIRECT_URI=

# 서버 주소입니다. 다른 기기에서 접속하게 하려면 0.0.0.0 으로 바꾸세요. 이때 INVITE_CODE 는 필수입니다.
HOST=127.0.0.1
PORT=3000

# 한 주의 시작(월요일 0시)을 계산할 시간대입니다. 분 단위이며 한국은 540입니다.
TIMEZONE_OFFSET_MINUTES=540

# HTTPS로 배포할 때 1로 설정하세요.
COOKIE_SECURE=0

# GitHub Actions에서 수집할 때 저장 데이터를 암호화하는 키입니다. 길고 무작위인 값을 쓰세요.
DB_KEY=
